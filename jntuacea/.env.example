<?php
/**
 * Environment Configuration Template
 * 
 * Copy this file to `.env.php` in the parent directory (or project root)
 * and update with your database and environment configurations.
 */

if (!defined('DB_HOST')) {
    define('DB_HOST', 'localhost');
}

if (!defined('DB_USER')) {
    define('DB_USER', 'your_database_username');
}

if (!defined('DB_PASS')) {
    define('DB_PASS', 'your_database_password');
}

if (!defined('DB_NAME')) {
    define('DB_NAME', 'your_database_name');
}
